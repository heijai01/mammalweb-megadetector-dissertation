# Copy this file to .env and fill in real values locally.
# Never commit .env or real database credentials.

# Preferred: a full SQLAlchemy database URL for MySQL/MariaDB.
# Format:
# MAMMALWEB_DATABASE_URL=mysql+pymysql://username:password@host:3306/database_name
# If your password contains special characters, URL-encode them first.
MAMMALWEB_DATABASE_URL=

# Optional read-only defaults for exploratory queries.
# In MySQL/MariaDB this is usually the database name shown in phpMyAdmin.
MAMMALWEB_DB_SCHEMA=
MAMMALWEB_QUERY_LIMIT=1000

# Optional table names. Set these after inspecting the remote schema.
MAMMALWEB_IMAGES_TABLE=
MAMMALWEB_DETECTIONS_TABLE=
MAMMALWEB_LABELS_TABLE=
